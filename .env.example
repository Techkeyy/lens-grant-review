# Copy these names to your local environment. Never commit an actual API key.
# The base URL is the AI Data Gateway cluster UI origin, not Cloud Gateway.
ZETARIS_BASE_URL=https://YOUR-CLUSTER-HOSTNAME.cloud.zetaris.com
ZETARIS_ORG_ID=YOUR_NUMERIC_ORG_ID
ZETARIS_API_KEY=YOUR_PRIVATE_API_KEY
ZETARIS_QUERY_LIMIT=1000
ZETARIS_TIMESHEETS_TABLE=LENS_DEMO_FILES.timesheets
ZETARIS_RECEIPTS_TABLE=LENS_DEMO_FILES.receipts
ZETARIS_ACTIVITY_TABLE=LENS_DEMO_FILES.acivity_log
ZETARIS_REPORT_A_TABLE=LENS_DEMO_FILES.reading_future_drafts
ZETARIS_REPORT_B_TABLE=LENS_DEMO_FILES.community_learning_drafts

# Public deployment only. Set these in the private hosting environment.
# The anon or publishable key may be sent to browsers; the service-role key must not.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY_IN_HOSTING_DASHBOARD
LENS_ZETARIS_DEMO_OWNER_ID=YOUR_SUPABASE_USER_UUID

# Meterless Nightshift local/hotspot provider. Use the runtime's real token;
# the example value below is intentionally invalid. Never put it in Git.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_RUNTIME_TOKEN=YOUR_PRIVATE_RUNTIME_TOKEN
NIGHTSHIFT_MODEL=meterless/auto
